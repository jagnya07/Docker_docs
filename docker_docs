Running Containers (More Options)
----------------------------------
  # Run in background (detached mode)
  docker run -d nginx

  # Name your container
  docker run -d --name my-nginx nginx

  # Map ports (host:container)
  docker run -d -p 8080:80 nginx

  # Mount volumes (host:container)
  docker run -d -v /mydata:/data nginx

  # Set environment variables
  docker run -d -e MYSQL_ROOT_PASSWORD=secret mysql

  # Auto-remove container when it stops
  docker run --rm ubuntu echo "Hello World"


Interacting with Running Containers
-------------------------------------
  # Execute command inside running container
  docker exec -it my-nginx bash

  # View container logs
  docker logs my-nginx

  # Follow logs in real-time
  docker logs -f my-nginx

  # Inspect full container details
  docker inspect my-nginx

  # Copy files between host and container
  docker cp file.txt my-nginx:/usr/share/nginx/html/


Building Images with Dockerfile
---------------------------------
  Example Dockerfile:

    FROM node:18

    WORKDIR /app

    COPY package*.json ./
    RUN npm install

    COPY . .

    EXPOSE 3000

    CMD ["node", "server.js"]

  # Build image from Dockerfile
  docker build -t myapp:1.0 .

  # Build with specific Dockerfile
  docker build -f Dockerfile.prod -t myapp:prod .

  # Tag an image
  docker tag myapp:1.0 myusername/myapp:latest

  # Push to Docker Hub
  docker login
  docker push myusername/myapp:latest


Docker Networks
---------------
  # List networks
  docker network ls

  # Create a custom network
  docker network create my-network

  # Run container on a network
  docker run -d --network my-network --name db mysql

  # Connect existing container to a network
  docker network connect my-network my-nginx

  # Inspect network
  docker network inspect my-network


Docker Volumes
--------------
  # Create a named volume
  docker volume create mydata

  # Use named volume in container
  docker run -d -v mydata:/data mysql

  # List all volumes
  docker volume ls

  # Inspect volume
  docker volume inspect mydata

  # Remove unused volumes
  docker volume prune


